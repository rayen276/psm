# /etc/systemd/system/psm.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now psm
[Unit]
Description=PSM - Projects Manager
After=network.target mysql.service

[Service]
User=psm
WorkingDirectory=/opt/psm
ExecStart=/usr/bin/java -jar /opt/psm/psm.jar
EnvironmentFile=/opt/psm/psm.env
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
