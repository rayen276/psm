                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"libelle\": \"Projet modifie\",\n  \"budget\": 20000,\n  \"duree\": 5,\n  \"description\": \"Maj\",\n  \"clientId\": 1\n}"
            }
          }
        },
        {
          "name": "Supprimer (ADMIN seul)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projets/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projets",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
