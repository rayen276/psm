{
  "info": {
    "name": "PSM - Projects Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Register (-> email a l'admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"collab@psm.com\",\n  \"password\": \"123456\",\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Sami\",\n  \"tel\": \"22123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@psm.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login COLLABORATEUR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"collab@psm.com\",\n  \"password\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 - Clients",
      "item": [
        {
          "name": "Liste (ADMIN + COLLAB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            }
          }
        },
        {
          "name": "Ajouter (ADMIN + COLLAB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Nouveau Client\",\n  \"tel\": \"70 000 000\",\n  \"email\": \"client@mail.tn\",\n  \"adresse\": \"Sfax\"\n}"
            }
          }
        },
        {
          "name": "Modifier (ADMIN seul -> 403 pour COLLAB)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Client modifie\",\n  \"tel\": \"70 111 111\",\n  \"email\": \"client@mail.tn\",\n  \"adresse\": \"Sousse\"\n}"
            }
          }
        },
        {
          "name": "Supprimer (ADMIN seul -> 403 pour COLLAB)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 - Projets",
      "item": [
        {
          "name": "Liste",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projets"
              ]
            }
          }
        },
        {
          "name": "Liste d'un client",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projets?clientId=1",
              "host": [
                "{{baseUrl}}"
              ],
