            }
          }
        },
        {
          "name": "Modifier (ADMIN seul)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projets/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
